# Copy to .env and replace placeholders. Keep .env private; this template is safe to commit.
CI_ENV=development
CI_BASE_URL=http://localhost:8086/
CMS_DB_HOST=cms-db
CMS_DB_NAME=cmsdb
CMS_DB_USER=replace_with_local_db_user
CMS_DB_PASSWORD=replace_with_local_db_password
CMS_DB_ROOT_PASSWORD=replace_with_local_db_root_password


TIME_ZONE=utc

# Database backups (UTC)
BACKUP_ENABLED=1
BACKUP_TIME=02:00
BACKUP_RETENTION=30
