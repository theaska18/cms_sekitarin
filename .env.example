# Copy to .env and replace placeholders. Keep .env private; this template is safe to commit.
CI_BASE_URL=http://localhost:8088/
CMS_DB_HOST=cms-db
CMS_DB_PORT=3306
CMS_DB_NAME=cmsdb_sekitarin
CMS_DB_USER=replace_with_local_db_user
CMS_DB_PASSWORD=replace_with_local_db_password
CMS_DB_ROOT_PASSWORD=replace_with_local_db_root_password

# Shared secret between the CMS and the WebSocket gateway.
SEKITAR_WS_SECRET=replace_with_random_shared_secret



# Database backups (UTC)
BACKUP_ENABLED=1
BACKUP_TIME=02:00
BACKUP_RETENTION=30

# Jitsi voice/video calls (JWT auth deployment).
SEKITAR_JITSI_URL=https://jitsi.ckamal.com
SEKITAR_JITSI_APP_ID=replace_with_jitsi_app_id
SEKITAR_JITSI_SECRET=replace_with_jitsi_jwt_secret
SEKITAR_JITSI_DOMAIN=meet.jitsi
SEKITAR_JITSI_AUDIENCE=jitsi
